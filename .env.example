# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
SIMULATOR_URL=http://localhost:5175
# Dev only: cho mở mô phỏng trước giờ bắt đầu buổi tập (bị bỏ qua khi NODE_ENV=production)
SIMULATOR_ALLOW_EARLY=false

# Database Configuration (PostgreSQL / Supabase / Local PostgreSQL)
# For Supabase:
# DATABASE_URL: Transaction pooler URL (e.g., port 6543)
# DIRECT_URL: Direct session connection URL for Prisma migrations (e.g., port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:3333/equiflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:3333/equiflow?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="equiflow-secure-jwt-secret-replace-in-production-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="equiflow-secure-refresh-jwt-secret-replace-in-production-2026"
JWT_REFRESH_EXPIRES_IN="7d"
# OAuth Web Client ID from Google Cloud; leave empty until Google sign-in is configured.
GOOGLE_CLIENT_ID=""

# Email / Notification Configuration (For Staff Invite & Owner OTP verification)
# Có 3 chế độ: "resend", "smtp", hoặc "mock"
# 1. EMAIL_PROVIDER="resend": Gửi qua Resend API (Khuyên dùng)
#    RESEND_API_KEY="re_xxxxxxxxxxxx"
#    EMAIL_FROM="TMEC System <onboarding@resend.dev>" (hoặc email domain đã verify)
# 2. EMAIL_PROVIDER="smtp": Gửi qua SMTP (Gmail App Password hoặc Resend SMTP)
#    SMTP_HOST="smtp.gmail.com" (hoặc "smtp.resend.com")
#    SMTP_PORT=587
#    SMTP_USER="your-email@gmail.com" (hoặc "resend")
#    SMTP_PASS="your-16-char-app-password" (hoặc API key của Resend)
#    EMAIL_FROM="TMEC System <your-email@gmail.com>"
# 3. EMAIL_PROVIDER="mock" hoặc để trống key => OTP sẽ in trực tiếp ra server console log
# 4. Fallback tự động khi dùng Resend (chạm 100 mail/ngày hoặc lỗi mạng):
#    - Trên local (chạy Mailpit): giữ EMAIL_PROVIDER="resend" + MAIL_HOST=127.0.0.1, MAIL_PORT=1025, SMTP_USER=""
#      hoặc đổi thẳng EMAIL_PROVIDER="smtp".
#    - Trên deploy (gửi Gmail thật khi Resend hết hạn mức): thêm SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#      SMTP_USER="your-email@gmail.com", SMTP_PASS="<app-password>", tùy chọn SMTP_FROM="TMEC System <your-email@gmail.com>".
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="TMEC System <onboarding@resend.dev>"
# --- Mailpit (dev/test) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=""
# Public frontend origin used in authenticated business-mail links.
BUSINESS_MAIL_BASE_URL=http://localhost:5173
# true = mọi mã OTP luôn là 123456 (tiện test). Đặt false khi gửi mail thật.
DEV_FIXED_OTP=true

# GitHub Project Management (Governance)
GITHUB_PROJECT_URL=https://github.com/users/MichaelTran1226/projects/2
GITHUB_OWNER=MichaelTran1226
GITHUB_DEFAULT_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_BE_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_FE_REPOSITORY=Racehorse_Training_Management_System_MT_FE
GITHUB_PROJECT_NUMBER=2
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=main

# Demo Data Chat: chỉ development + PostgreSQL loopback + Quản lý ACTIVE.
# Không bật trên production; không có reset/seed tự động.
DEMO_DATA_ENABLED=false
# Gemini gọi từ backend; điền key và model hỗ trợ function calling trên máy local.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# PayOS Payment Gateway (https://payos.vn/)
# Lấy tại mục Kênh thanh toán / Tích hợp thanh toán trên dashboard PayOS.
# Nếu bỏ trống: Hệ thống tự động chuyển sang VietQR TMEC chuẩn + Fallback giả lập 1-click cho việc Demo/Sát hạch.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

