# Chép thành deploy/backend.env trên VPS rồi điền. File này chứa bí mật, KHÔNG commit.
# DATABASE_URL / DIRECT_URL do docker-compose.prod.yml tự ghép, không cần điền ở đây.
PORT=3000
NODE_ENV=production
API_PREFIX=/api
FRONTEND_URL=https://tmec.site
SIMULATOR_URL=https://sim.tmec.site

# Sinh mỗi giá trị bằng: openssl rand -hex 32  (hai giá trị phải khác nhau)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Email gửi OTP. Gmail: bật xác minh 2 bước rồi tạo App Password tại https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TMEC System <dia-chi-gmail-o-tren@gmail.com>"

# BẮT BUỘC false trên web thật (true = mã OTP luôn là 123456).
DEV_FIXED_OTP=false

# Trợ lý AI: để trống GEMINI_API_KEY thì trợ lý chỉ trích đoạn tài liệu, không gọi Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_DAILY_LIMIT=50

# Đăng nhập Google: để trống cho tới Bước 10.
GOOGLE_CLIENT_ID=

GITHUB_PROJECT_DRY_RUN=true
