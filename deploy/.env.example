# Chép thành deploy/.env trên VPS rồi điền. File .env không được commit.
# Mật khẩu DB: chỉ dùng chữ và số (sinh bằng: openssl rand -hex 24) để không làm hỏng DATABASE_URL.
POSTGRES_PASSWORD=
# Email nhận thông báo từ Let's Encrypt khi chứng chỉ HTTPS sắp hết hạn.
ACME_EMAIL=
# Để trống cho tới khi bật đăng nhập Google (Bước 10).
GOOGLE_CLIENT_ID=
